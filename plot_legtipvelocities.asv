function plot_legtipvelocities

    leg_params = define_leg_parameters();

    vertex_coords_guess = [...
        [   0;  50];... %vertex 1 guess
        [ -50;   0];... %vertex 2 guess
        [ -50;  50];... %vertex 3 guess
        [-100;   0];... %vertex 4 guess
        [-100; -50];... %vertex 5 guess
        [ -50; -50];... %vertex 6 guess
        [ -50;-100]...  %vertex 7 guess
    ];

    tvertex = 7;
    tx = 2*tvertex - 1;
    ty = 2*tvertex;

    theta_val = linspace(0, 2*pi, 100);
    dx_tip_analytical = zeros(size(theta_val));
    dy_tip_analytical = zeros(size(theta_val));
    dx_tip_numerical = zeros(size(theta_val));
    dy_tip_numerical = zeros(size(theta_val));
    vertex_coords = vertex_coords_guess;

    for i = 1:length(theta_val)
        theta_ = theta_val(i);
        vertex_coords = compute_coords(vertex_coords, leg_params, theta_);

        dVdtheta = compute_velocities(vertex_coords, leg_params, theta_);


        coords_wrapped = @(theta_val)compute_coords(vertex_coords, leg_params, theta_val);
        numerical_computation = approximate_jacobian(coords_wrapped, theta_);
    
    
        dx_tip_analytical(i) = dVdtheta(tx);
        dy_tip_analytical(i) = dVdtheta(ty);
        dx_tip_numerical(i) = numerical_computation(tx);
        dy_tip_numerical(i) = numerical_computation(ty);
    end 

    %Plot 1
    figure(1);
    hold on;
    plot(theta_val, dx_tip_analytical, 'g', 'LineWidth', 3)
    plot(theta_val, dx_tip_numerical, 'k--', 'LineWidth', 3)
    title('Rate of Change of Leg Tip x-Pos of Strandbeest for Crank Angle $\theta$', 'Interpreter', 'latex', 'FontSize', 20)
    xlabel('Crank Angle $\theta$ (rad)', 'Interpreter', 'latex')
    ylabel('$dx_{tip}/d\theta$ (-)','Interpreter', 'latex')

    %Plot 2
    figure(2);
    hold on;
    plot(theta_val, dy_tip_analytical, 'g', 'LineWidth', 3)
    plot(theta_val, dy_tip_numerical, 'k--', 'LineWidth', 3)
    title('Change in y-value of Strandbeest for Motor $\theta$')

    xlim([0 2*pi]);

   

end 
